---
import { useTranslations, type Lang } from '~/i18n';

interface Props {
  href: string;
  title: string;
  summary: string;
  year: string;
  role: string;
  stack: string[];
  number?: string;
  cover?: string;
  coverVideo?: string;
  lang: Lang;
}

const { href, title, summary, year, role, stack, number, cover, coverVideo, lang } = Astro.props;
const t = useTranslations(lang);
---

<a class={`project-card ${cover ? 'has-cover' : ''}`} href={href}>
  <article>
    {cover && (
      <div class="card-media" aria-hidden="true">
        {coverVideo
          ? <video src={coverVideo} poster={cover} muted loop playsinline preload="none" data-hover-play></video>
          : <img src={cover} alt="" loading="lazy" decoding="async" />}
      </div>
    )}
    <header class="card-header">
      {number && <span class="card-num">{number}</span>}
      <div class="card-meta">
        <span>{year}</span>
        <span class="dot">·</span>
        <span>{role}</span>
      </div>
    </header>

    <h3 class="card-title">
      {title}
      <span class="card-arrow" aria-hidden="true">→</span>
    </h3>

    <p class="card-summary">{summary}</p>

    <ul class="card-stack">
      {stack.slice(0, 4).map((s) => <li>{s}</li>)}
      {stack.length > 4 && <li class="more">+{stack.length - 4}</li>}
    </ul>
  </article>
</a>

<script>
  // 有影片的封面：滑鼠移上去才載入並播放，移開就暫停。觸控裝置只顯示封面圖。
  if (matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
    document.querySelectorAll<HTMLVideoElement>('video[data-hover-play]').forEach((v) => {
      const card = v.closest('a')!;
      card.addEventListener('mouseenter', () => { v.play().catch(() => {}); });
      card.addEventListener('mouseleave', () => { v.pause(); });
    });
  }
</script>

<style>
  .project-card {
    display: block;
    color: inherit;
    text-decoration: none;
    padding: 2rem 0;
    border-top: 1px solid var(--rule);
    transition: padding var(--duration-base) var(--ease-out);
  }

  .project-card:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .project-card:hover {
    padding-left: 1rem;
  }

  .project-card:hover .card-title {
    color: var(--accent);
  }

  .project-card:hover .card-arrow {
    transform: translateX(6px);
    color: var(--accent);
  }

  .has-cover article {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    grid-template-areas:
      'header media'
      'title media'
      'summary media'
      'stack media';
    grid-template-rows: auto auto auto 1fr;
    column-gap: 2rem;
  }
  .has-cover .card-header { grid-area: header; }
  .has-cover .card-title { grid-area: title; }
  .has-cover .card-summary { grid-area: summary; }
  .has-cover .card-stack { grid-area: stack; align-self: start; }
  .card-media {
    grid-area: media;
    align-self: start;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--paper-tint);
  }
  .card-media img,
  .card-media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .project-card:hover .card-media img,
  .project-card:hover .card-media video {
    transform: scale(1.03);
  }
  @media (max-width: 720px) {
    .has-cover article {
      grid-template-columns: 1fr;
      grid-template-areas: 'media' 'header' 'title' 'summary' 'stack';
      grid-template-rows: none;
    }
    .card-media { margin-bottom: 1rem; }
  }

  .card-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .card-num {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--accent);
    font-weight: 500;
  }

  .card-meta {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .dot {
    margin-inline: 0.4rem;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    transition: color var(--duration-base) var(--ease-out);
  }

  .card-arrow {
    display: inline-block;
    font-size: var(--step-1);
    color: var(--ink-faint);
    transition:
      transform var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }

  .card-summary {
    color: var(--ink-soft);
    max-width: 60ch;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .card-stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .card-stack li {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    padding: 0.2em 0.6em;
    border: 1px solid var(--rule);
    border-radius: 3px;
    color: var(--ink-soft);
    background: var(--paper-tint);
  }

  .card-stack .more {
    color: var(--ink-faint);
    background: transparent;
    border-color: transparent;
  }
</style>
