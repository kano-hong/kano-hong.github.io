---
import { useTranslations, type Lang } from '~/i18n';

interface Props {
  href: string;
  title: string;
  summary: string;
  year: string;
  role: string;
  stack: string[];
  number?: string;
  lang: Lang;
}

const { href, title, summary, year, role, stack, number, lang } = Astro.props;
const t = useTranslations(lang);
---

<a class="project-card" href={href}>
  <article>
    <header class="card-header">
      {number && <span class="card-num">{number}</span>}
      <div class="card-meta">
        <span>{year}</span>
        <span class="dot">·</span>
        <span>{role}</span>
      </div>
    </header>

    <h3 class="card-title">
      {title}
      <span class="card-arrow" aria-hidden="true">→</span>
    </h3>

    <p class="card-summary">{summary}</p>

    <ul class="card-stack">
      {stack.slice(0, 4).map((s) => <li>{s}</li>)}
      {stack.length > 4 && <li class="more">+{stack.length - 4}</li>}
    </ul>
  </article>
</a>

<style>
  .project-card {
    display: block;
    color: inherit;
    text-decoration: none;
    padding: 2rem 0;
    border-top: 1px solid var(--rule);
    transition: padding var(--duration-base) var(--ease-out);
  }

  .project-card:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .project-card:hover {
    padding-left: 1rem;
  }

  .project-card:hover .card-title {
    color: var(--accent);
  }

  .project-card:hover .card-arrow {
    transform: translateX(6px);
    color: var(--accent);
  }

  .card-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .card-num {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--accent);
    font-weight: 500;
  }

  .card-meta {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .dot {
    margin-inline: 0.4rem;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    transition: color var(--duration-base) var(--ease-out);
  }

  .card-arrow {
    display: inline-block;
    font-size: var(--step-1);
    color: var(--ink-faint);
    transition:
      transform var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }

  .card-summary {
    color: var(--ink-soft);
    max-width: 60ch;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .card-stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .card-stack li {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    padding: 0.2em 0.6em;
    border: 1px solid var(--rule);
    border-radius: 3px;
    color: var(--ink-soft);
    background: var(--paper-tint);
  }

  .card-stack .more {
    color: var(--ink-faint);
    background: transparent;
    border-color: transparent;
  }
</style>
