---
// 短循環影片（無聲、捲到畫面裡才載入並播放，離開就暫停）。src 留空時只在開發模式顯示占位框，正式建置不輸出。
interface Props {
  src?: string;
  poster?: string;
  caption: string;
}
const { src, poster, caption } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{src ? (
  <figure class="video">
    <video
      src={`${base}${src}`}
      poster={poster && `${base}${poster}`}
      muted
      loop
      playsinline
      controls
      preload="none"
      data-inview
    />
    <figcaption>{caption}</figcaption>
  </figure>
) : import.meta.env.DEV && (
  <figure class="video">
    <div class="placeholder">待錄影片</div>
    <figcaption>{caption}</figcaption>
  </figure>
)}

<script>
  // 一頁有很多段影片時，同時自動播放會一次下載全部：改成進入畫面才播放、離開就暫停。
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-inview]');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!still && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) v.play().catch(() => {});
        else v.pause();
      }
    }, { threshold: 0.25 });
    videos.forEach((v) => io.observe(v));
  }
</script>

<style>
  .video {
    margin: 2rem 0;
  }
  video,
  .placeholder {
    display: block;
    width: 100%;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--paper-tint);
  }
  video {
    height: auto;
  }
  .placeholder {
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    border-style: dashed;
    font-family: var(--font-mono);
    color: var(--ink-faint);
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
</style>
