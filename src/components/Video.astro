---
// 短循環影片（無聲、自動播放、可暫停）。src 留空時只在開發模式顯示占位框，正式建置不輸出。
interface Props {
  src?: string;
  poster?: string;
  caption: string;
}
const { src, poster, caption } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{src ? (
  <figure class="video">
    <video
      src={`${base}${src}`}
      poster={poster && `${base}${poster}`}
      autoplay
      muted
      loop
      playsinline
      controls
      preload="metadata"
    />
    <figcaption>{caption}</figcaption>
  </figure>
) : import.meta.env.DEV && (
  <figure class="video">
    <div class="placeholder">待錄影片</div>
    <figcaption>{caption}</figcaption>
  </figure>
)}

<style>
  .video {
    margin: 2rem 0;
  }
  video,
  .placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--paper-tint);
  }
  .placeholder {
    display: grid;
    place-items: center;
    border-style: dashed;
    font-family: var(--font-mono);
    color: var(--ink-faint);
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
</style>
