---
import { type Lang } from '~/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const title = lang === 'zh-TW' ? '關於我' : 'About';
const eyebrow = lang === 'zh-TW' ? '個人介紹' : 'Bio';

const intro =
  lang === 'zh-TW'
    ? '我是 Kano Hong（洪嘉濃），住在新北板橋。Front-end Tech Lead，遊戲產業十一年。'
    : "I'm Kano Hong, based in Banqiao, New Taipei, Taiwan. Front-end Tech Lead, eleven years in the game industry.";

const story = lang === 'zh-TW'
  ? [
      '我從拉霸機台寫起，然後是德州撲克、麻將、輪盤、捕魚機——遊戲機房裡會出現的東西大概都做過了一輪。',
      '這幾年我比較感興趣的，是把那些「每次新專案都要重新踩一遍的坑」變成可以重複使用的架構。子遊戲註冊機制、XState 狀態管理、MobX-Keystone 資料層、Figma 到 Cocos 的自動化 plugin——都是這個方向長出來的東西。',
      '工作之外我會把日常流程寫成腳本。我的原則是：如果一件事手動做超過十秒鐘，就值得寫成自動化。',
    ]
  : [
      'I started with slot machines, then Texas Hold\'em, mahjong, roulette, fishing games — most of what you\'d find in a game lobby, I\'ve shipped a version of.',
      'These days I\'m most interested in turning "the same pitfall every new project hits" into reusable infrastructure: sub-game registries, XState state management, MobX-Keystone data layers, Figma-to-Cocos automation plugins — all branches of the same instinct.',
      'Outside work I script my way through everyday tasks. My rule: if it takes more than ten seconds by hand, it deserves automation.',
    ];

const facts = lang === 'zh-TW'
  ? [
      { label: '現職', value: 'Front-end Tech Lead' },
      { label: '公司', value: '新數字有限公司' },
      { label: '位置', value: '台灣 · 新北板橋' },
      { label: '經歷', value: '11 年遊戲產業 / 4 家公司' },
      { label: '語言', value: '繁體中文（母語）· English' },
    ]
  : [
      { label: 'Role', value: 'Front-end Tech Lead' },
      { label: 'Company', value: 'Newdigit Co., Ltd.' },
      { label: 'Location', value: 'Banqiao, New Taipei, Taiwan' },
      { label: 'Experience', value: '11 years across 4 companies' },
      { label: 'Languages', value: 'Traditional Chinese (native) · English' },
    ];

const stack = [
  'Cocos Creator 3.x', 'TypeScript', 'xstate 5', 'MobX', 'Protobuf / WebSocket',
  'WebGL · Basis Universal / ASTC', 'PWA · Workbox', 'Vitest', 'k6',
  'Node.js', 'Docker Compose', 'Nginx', 'Jenkins', 'GitLab API',
  'Prometheus / Grafana', 'ELK', 'Python', 'Claude Code · MCP',
];

const timeline = lang === 'zh-TW'
  ? [
      { when: '2024.02 – 至今', where: '新數字有限公司（XGaming）', role: 'Front-end Tech Lead', what: '帶約 10 人的 Cocos 團隊，負責德州撲克的 Web／PWA、原生 App、Telegram Mini App 與子遊戲平台；2026 年起兼管 CI/CD 與正式環境維運。' },
      { when: '2020.08 – 2024.02', where: '樂榮科技', role: 'FrontEnd Develop Lead', what: '主導前端由 PixiJS 轉 Cocos Creator、建立 CI/CD；開發德州撲克與小遊戲。' },
      { when: '2019.03 – 2020.08', where: '奇點數位科技', role: '程式主任', what: '主導前端由 Egret 轉 Cocos Creator，兼做後台（Django、Vue）；開發 Slot 與撲克。' },
      { when: '2013.07 – 2019.03', where: '向上國際科技', role: 'Senior Mobile Game Programmer', what: '以 Cocos2d-x／Cocos Creator 開發 Slot、棋牌與視訊遊戲，參與組建研發團隊。' },
    ]
  : [
      { when: '2024.02 – now', where: 'Newdigit Co., Ltd. (XGaming)', role: 'Front-end Tech Lead', what: 'Lead a ~10-engineer Cocos team across Texas Hold’em (web/PWA, native apps, Telegram Mini App) and a sub-game platform; since 2026 I also own CI/CD and production operations.' },
      { when: '2020.08 – 2024.02', where: '樂榮科技', role: 'FrontEnd Develop Lead', what: 'Led the front-end move from PixiJS to Cocos Creator and set up CI/CD; built Texas Hold’em and casual games.' },
      { when: '2019.03 – 2020.08', where: '奇點數位科技', role: 'Lead Programmer', what: 'Led the front-end move from Egret to Cocos Creator and built back-office tools (Django, Vue); shipped slot and poker games.' },
      { when: '2013.07 – 2019.03', where: '向上國際科技', role: 'Senior Mobile Game Programmer', what: 'Built slot, card and live-dealer games with Cocos2d-x and Cocos Creator, and helped build up the R&D team.' },
    ];

const genresShipped = lang === 'zh-TW'
  ? ['拉霸 Slot', '德州撲克 Texas Hold\'em', '麻將 Mahjong', '輪盤 Roulette', '捕魚機 Fishing']
  : ['Slot', "Texas Hold'em", 'Mahjong', 'Roulette', 'Fishing'];
---

<section class="page-head">
  <div class="wrap-narrow">
    <p class="eyebrow rise">{eyebrow}</p>
    <h1 class="page-title rise delay-1">{title}</h1>
    <p class="lede rise delay-2 serif-italic">{intro}</p>
  </div>
</section>

<section class="page-body">
  <div class="wrap-narrow">
    <div class="prose-block">
      {story.map((p) => <p>{p}</p>)}
    </div>

    <hr />

    <div class="timeline">
      <h2 class="block-heading">{lang === 'zh-TW' ? '經歷' : 'Experience'}</h2>
      <ol>
        {timeline.map((j) => (
          <li>
            <p class="tl-when">{j.when}</p>
            <p class="tl-head"><strong>{j.where}</strong> · {j.role}</p>
            <p class="tl-what">{j.what}</p>
          </li>
        ))}
      </ol>
    </div>

    <hr />

    <div class="facts">
      <h2 class="block-heading">{lang === 'zh-TW' ? '一些基本資訊' : 'At a glance'}</h2>
      <dl>
        {facts.map((f) => (
          <div class="fact-row">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <hr />

    <div class="genres">
      <h2 class="block-heading">{lang === 'zh-TW' ? '出過貨的遊戲類型' : 'Genres shipped'}</h2>
      <ul class="genre-list">
        {genresShipped.map((g) => <li>{g}</li>)}
      </ul>
    </div>

    <hr />

    <div class="stack-block">
      <h2 class="block-heading">{lang === 'zh-TW' ? '常用技術' : 'Tech I use'}</h2>
      <ul class="stack-list">
        {stack.map((s) => <li>{s}</li>)}
      </ul>
    </div>

    <hr />

    <div class="contact-block">
      <h2 class="block-heading">{lang === 'zh-TW' ? '聯絡' : 'Get in touch'}</h2>
      <p>
        {lang === 'zh-TW'
          ? '工作機會、合作邀請、技術討論都歡迎。'
          : "Open to work opportunities, collaborations, and technical discussions."}
      </p>
      <ul class="contact-list">
        <li><a href="mailto:az198071123@gmail.com">az198071123@gmail.com</a></li>
        <li><a href="https://github.com/az198071123" target="_blank" rel="noopener noreferrer">github.com/az198071123</a></li>
        <li><a href="https://www.linkedin.com/in/kano-hong" target="_blank" rel="noopener noreferrer">linkedin.com/in/kano-hong</a></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .page-head {
    padding-top: clamp(3rem, 8vh, 5rem);
    padding-bottom: clamp(2rem, 5vh, 4rem);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--step-5);
    font-weight: 400;
    letter-spacing: -0.035em;
    margin-block: 0.75rem 1.5rem;
  }

  .lede {
    font-size: var(--step-2);
    color: var(--ink-soft);
    line-height: 1.4;
    max-width: 30ch;
  }

  .page-body {
    padding-bottom: var(--section-y);
  }

  .prose-block p {
    font-size: var(--step-1);
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 56ch;
  }

  .prose-block p + p {
    margin-top: 1.25em;
  }

  .block-heading {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 1.25rem;
  }

  .facts dl {
    display: grid;
    gap: 0.75rem;
  }

  .fact-row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .fact-row dt {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .fact-row dd {
    margin: 0;
    color: var(--ink);
  }

  .genre-list,
  .stack-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .genre-list li,
  .stack-list li {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    padding: 0.35em 0.85em;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--paper-tint);
    color: var(--ink-soft);
  }

  .genre-list li {
    border-color: var(--accent-tint);
    background: var(--accent-tint);
    color: var(--accent-deep);
  }

  .timeline ol {
    list-style: none;
    display: grid;
    gap: 1.5rem;
  }

  .timeline li {
    padding-left: 1rem;
    border-left: 2px solid var(--rule);
  }

  .tl-when {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .tl-head {
    margin-top: 0.25rem;
    color: var(--ink);
  }

  .tl-what {
    margin-top: 0.25rem;
    color: var(--ink-soft);
    line-height: 1.6;
    max-width: 56ch;
  }

  .contact-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .contact-list a {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink);
  }
</style>
