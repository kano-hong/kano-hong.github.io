---
import { getCollection } from 'astro:content';
import Hero from '~/components/Hero.astro';
import SectionHeading from '~/components/SectionHeading.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import PostCard from '~/components/PostCard.astro';
import Stats from '~/components/Stats.astro';
import { useTranslations, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = lang === 'zh-TW' ? '' : '/en';

const allProjects = await getCollection('projects', (e) => e.data.lang === lang);
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const allPosts = await getCollection('blog', (e) => !e.data.draft && e.data.lang === lang);
const recentPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const team =
  lang === 'zh-TW'
    ? {
        eyebrow: '帶團隊',
        title: '寫程式之外，我也負責讓整個團隊把東西送上線',
        stats: [
          { value: '約 10 人', label: '帶領的 Cocos 前端團隊' },
          { value: '190 個', label: '組員交給我審核合併的 MR' },
          { value: '113 個', label: '擔任發版窗口 7 個月送出的 UAT 版本' },
          { value: '13 次', label: '由我發起的 Prod 上版審批' },
        ],
        body: '面試 13 場以上、替新人訂 7 階段學習路線、制定 code review 流程、做績效考核。2024 年底推行上線審批流程，2025-08 起擔任德州撲克前端的發版窗口，彙整最多 5 位組員的變更送 UAT。數字來自 2024–2026 在新數字有限公司（XGaming）的 Lark 紀錄。',
      }
    : {
        eyebrow: 'Leading the team',
        title: 'Beyond my own code, I make sure the whole team ships',
        stats: [
          { value: '~10', label: 'engineers on the Cocos front-end team I lead' },
          { value: '190', label: 'merge requests teammates sent me to review and merge' },
          { value: '113', label: 'UAT builds shipped in 7 months as release owner' },
          { value: '13', label: 'production release approvals I filed' },
        ],
        body: 'I ran 13+ interviews, wrote a 7-stage onboarding path for new hires, set up the code review process and did performance reviews. In late 2024 I introduced a release approval process, and from 2025-08 I owned front-end releases for the Texas Hold’em products, batching changes from up to 5 teammates into each UAT build. Numbers come from Lark records at Newdigit Co., Ltd. (XGaming), 2024–2026.',
      };
---

<Hero lang={lang} />

<section class="section">
  <div class="wrap">
    <SectionHeading
      eyebrow={t('home.work.eyebrow')}
      title={t('home.work.title')}
      viewAll={{ label: t('home.work.viewAll'), href: `${base}${prefix}/work/` }}
    />

    <div class="card-list">
      {
        featuredProjects.length === 0 && (
          <p class="empty">
            {lang === 'zh-TW'
              ? '案例正在整理中，敬請期待。'
              : 'Case studies coming soon.'}
          </p>
        )
      }
      {
        featuredProjects.map((p, i) => (
          <ProjectCard
            href={`${base}${prefix}/work/${p.data.slug}/`}
            title={p.data.title}
            summary={p.data.summary}
            year={p.data.year}
            role={p.data.role}
            stack={p.data.stack}
            number={String(i + 1).padStart(2, '0')}
            lang={lang}
          />
        ))
      }
    </div>
  </div>
</section>

<section class="section team-block">
  <div class="wrap">
    <SectionHeading eyebrow={team.eyebrow} title={team.title} />
    <Stats items={team.stats} />
    <p class="team-body">{team.body}</p>
  </div>
</section>

<section class="section section-tinted">
  <div class="wrap">
    <SectionHeading
      eyebrow={t('home.writing.eyebrow')}
      title={t('home.writing.title')}
      viewAll={{ label: t('home.writing.viewAll'), href: `${base}${prefix}/writing/` }}
    />

    <div class="card-list">
      {
        recentPosts.length === 0 && (
          <p class="empty">
            {lang === 'zh-TW'
              ? '文章正在撰寫中。'
              : 'Writing in progress.'}
          </p>
        )
      }
      {
        recentPosts.map((post) => (
          <PostCard
            href={`${base}${prefix}/writing/${post.data.slug}/`}
            title={post.data.title}
            summary={post.data.summary}
            date={post.data.date}
            readTime={post.data.readTime}
            tags={post.data.tags}
            lang={lang}
          />
        ))
      }
    </div>
  </div>
</section>

<section class="section about-block">
  <div class="wrap">
    <div class="about-grid">
      <div class="about-content">
        <p class="eyebrow">{t('home.about.eyebrow')}</p>
        <h2 class="about-title">{t('home.about.title')}</h2>
        <p class="about-body">{t('home.about.body')}</p>
        <a class="about-link" href={`${base}${prefix}/about/`}>
          {t('home.about.more')}
        </a>
      </div>

      <div class="about-aside" aria-hidden="true">
        <div class="aside-card">
          <p class="aside-quote serif-italic">
            “{lang === 'zh-TW'
              ? '如果手動處理事情超過 10 秒，就寫腳本。'
              : 'If a manual task takes more than 10 seconds, write a script.'}”
          </p>
          <p class="aside-attr">— {lang === 'zh-TW' ? '個人原則' : 'Personal rule'}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: var(--section-y);
  }

  .team-block {
    padding-top: 0;
  }

  .team-body {
    max-width: 62ch;
    color: var(--ink-soft);
    line-height: 1.7;
  }

  .section-tinted {
    background: var(--paper-tint);
    border-block: 1px solid var(--rule);
  }

  .card-list {
    display: flex;
    flex-direction: column;
  }

  .empty {
    padding: 3rem 0;
    color: var(--ink-faint);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
  }

  /* About block */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 880px) {
    .about-grid {
      grid-template-columns: 3fr 2fr;
      gap: 5rem;
      align-items: start;
    }
  }

  .about-content .eyebrow {
    margin-bottom: 1rem;
  }

  .about-title {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 1.5rem;
    max-width: 20ch;
  }

  .about-body {
    font-size: var(--step-1);
    color: var(--ink-soft);
    line-height: 1.65;
    margin-bottom: 1.5rem;
    max-width: 56ch;
  }

  .about-link {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 2px;
    transition: color var(--duration-base) var(--ease-out);
  }

  .about-link:hover {
    color: var(--accent);
  }

  .aside-card {
    padding: 2rem;
    background: var(--paper-tint);
    border: 1px solid var(--rule);
    border-radius: 4px;
    position: relative;
  }

  .aside-card::before {
    content: '"';
    position: absolute;
    top: -0.5rem;
    left: 1.5rem;
    font-family: var(--font-display);
    font-size: 5rem;
    line-height: 1;
    color: var(--accent);
    font-style: italic;
  }

  .aside-quote {
    font-size: var(--step-2);
    line-height: 1.35;
    color: var(--ink);
    margin-top: 1.5rem;
    margin-bottom: 1rem;
  }

  .aside-attr {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
</style>
