---
// 互動 demo：283 個 repo 依波次搬到新站的過程。每格是一個 repo：
// 灰＝還在舊站、淺色＝已複製、主色＝已校驗、深色＝已切換。數字照實際遷移紀錄。
interface Props { lang?: 'zh-TW' | 'en' }
const { lang = 'zh-TW' } = Astro.props;
const T = {
  'zh-TW': {
    waves: [
      { n: 1, label: '試跑：先搬 1 個小 repo，確認 LFS 與子模組指標都對' },
      { n: 250, label: '第一波：250 個沒人在改的 repo（約 1 成因新站 SSH 偶發換金鑰失敗，重跑補齊）' },
      { n: 3, label: 'Slot 平台前端 3 個（最大的 12 GB）' },
      { n: 22, label: '第二波 A：測試中的產品與子遊戲 22 個' },
      { n: 4, label: '第二波 B：所有分支共用的 entry、base、建置腳本 4 個' },
      { n: 3, label: '最後：還在開發的德州撲克 Web 版系列 3 個' },
    ],
    play: '▶ 播放', reset: '重設', idle: '按播放，看 283 個 repo 怎麼搬。',
    copied: '已複製', verified: '已校驗', cut: '已切換',
    cutover: '切換日：凍結推送 → 283 個與舊站逐一比對完全一致 → 改寫子模組與套件網址 → 切換',
    done: '切換完成：112 個 webhook 0 失敗，隔天三條產品線 89 款遊戲建置全部通過。',
    caption: '複製期間舊站一直是唯一的來源，開發者照常推。到了切換那天才凍結、逐一比對新舊兩邊，一次切過去。',
  },
  en: {
    waves: [
      { n: 1, label: 'Dry run: move 1 small repo and check LFS and submodule pointers' },
      { n: 250, label: 'Wave 1: 250 repos nobody was touching (about 1 in 10 failed on the new server’s occasional SSH host-key swap; a rerun filled them in)' },
      { n: 3, label: '3 slot-platform front-end repos (the largest is 12 GB)' },
      { n: 22, label: 'Wave 2A: 22 products and sub-games in testing' },
      { n: 4, label: 'Wave 2B: the 4 shared repos every branch uses (entry, base, build scripts)' },
      { n: 3, label: 'Last: the 3 poker web repos still in active development' },
    ],
    play: '▶ Play', reset: 'Reset', idle: 'Press play to watch 283 repos move.',
    copied: 'Copied', verified: 'Verified', cut: 'Cut over',
    cutover: 'Cutover day: freeze pushes → all 283 match the old server ref for ref → rewrite submodule and package URLs → switch',
    done: 'Done: 112 webhooks created with 0 failures; the next day all 89 games on three product lines built green.',
    caption: 'While copying, the old server stayed the only source of truth and developers kept pushing as usual. Only on cutover day was it frozen, compared side by side, and switched in one go.',
  },
}[lang];
---

<figure class="waves" data-waves={JSON.stringify(T.waves)} data-text={JSON.stringify({ idle: T.idle, cutover: T.cutover, done: T.done })}>
  <div class="bar">
    <button type="button" data-play>{T.play}</button>
    <button type="button" data-reset>{T.reset}</button>
    <span class="step" data-step aria-live="polite">{T.idle}</span>
  </div>
  <div class="grid" data-grid></div>
  <dl class="count">
    <div><dt>{T.copied}</dt><dd data-c="copied">0</dd></div>
    <div><dt>{T.verified}</dt><dd data-c="verified">0</dd></div>
    <div><dt>{T.cut}</dt><dd data-c="cut">0</dd></div>
  </dl>
  <figcaption>{T.caption}</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-waves]').forEach((root) => {
    const waves: { n: number; label: string }[] = JSON.parse(root.dataset.waves!);
    const text: { idle: string; cutover: string; done: string } = JSON.parse(root.dataset.text!);
    const total = waves.reduce((s, w) => s + w.n, 0);
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const step = root.querySelector<HTMLElement>('[data-step]')!;
    const play = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const cells = Array.from({ length: total }, () => grid.appendChild(document.createElement('i')));
    const count = (k: string, v: number) => (root.querySelector(`[data-c="${k}"]`)!.textContent = String(v));
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer = 0, run = 0;
    // 減少動態效果時省略逐格動畫，但每一波仍停留，讓說明讀得到
    const sleep = (ms: number) => new Promise((r) => (timer = window.setTimeout(r, still ? 0 : ms)));
    const pause = (ms: number) => new Promise((r) => (timer = window.setTimeout(r, still ? 1800 : ms)));

    function reset() {
      run++; clearTimeout(timer);
      cells.forEach((c) => (c.className = ''));
      ['copied', 'verified', 'cut'].forEach((k) => count(k, 0));
      step.textContent = text.idle;
      play.disabled = false;
    }

    async function start() {
      reset();
      const me = run; play.disabled = true;
      let i = 0, copied = 0;
      for (const w of waves) {
        step.textContent = w.label;
        const batch = cells.slice(i, i + w.n);
        const per = Math.max(4, 1200 / w.n);
        for (const [k, c] of batch.entries()) {
          if (me !== run) return;
          // 第一波約 1 成先失敗，之後重跑成功
          c.className = w.n > 100 && k % 10 === 3 ? 'fail' : 'copied';
          copied++; count('copied', copied);
          if (k % 5 === 4) await sleep(per * 5);
        }
        for (const c of batch) if (c.className === 'fail') c.className = 'copied';
        await sleep(500);
        if (me !== run) return;
        batch.forEach((c) => (c.className = 'verified'));
        count('verified', i + w.n);
        i += w.n;
        await pause(700);
      }
      step.textContent = text.cutover;
      await pause(1200);
      if (me !== run) return;
      cells.forEach((c) => (c.className = 'cut'));
      count('cut', total);
      step.textContent = text.done;
      play.disabled = false;
    }

    play.addEventListener('click', start);
    root.querySelector('[data-reset]')!.addEventListener('click', reset);
  });
</script>

<style>
  .waves {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--paper-tint);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-bottom: 1rem;
  }
  .bar button {
    font: inherit;
    font-size: var(--step--1);
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--ink-soft);
    border-radius: 3px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .bar button:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .bar button:disabled {
    color: var(--ink-faint);
    border-color: var(--rule);
    cursor: default;
  }
  .step {
    flex: 1 1 16rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12px, 1fr));
    gap: 3px;
  }
  .grid :global(i) {
    aspect-ratio: 1;
    border-radius: 2px;
    background: var(--rule);
    transition: background var(--duration-fast) var(--ease-out);
  }
  .grid :global(i.copied) {
    background: var(--accent-tint);
  }
  .grid :global(i.fail) {
    background: var(--ink);
  }
  .grid :global(i.verified) {
    background: var(--accent);
  }
  .grid :global(i.cut) {
    background: var(--accent-deep);
  }
  .count {
    display: flex;
    gap: 1.5rem;
    margin: 1rem 0 0;
    font-size: var(--step--1);
  }
  .count div {
    display: flex;
    gap: 0.4rem;
    align-items: baseline;
  }
  .count dt {
    color: var(--ink-faint);
  }
  .count dd {
    margin: 0;
    font-family: var(--font-mono);
    color: var(--ink);
  }
  figcaption {
    margin-top: 1rem;
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
  @media (prefers-reduced-motion: reduce) {
    .grid :global(i) {
      transition: none;
    }
  }
</style>
