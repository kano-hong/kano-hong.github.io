---
// 2026-10-30 那次崩潰的時間線，取自系統日誌的毫秒順序。左邊放大前 50 毫秒，右邊是接下來的 12 秒。
// 只有區間、沒有逐台時間，所以畫成色帶，不畫 8 條各自的線。
interface Props { lang?: 'zh-TW' | 'en' }
const { lang = 'zh-TW' } = Astro.props;

type Band = { from: number; to: number; label: string; time: string; kind?: 'bad' | 'ok' | 'span' | 'gap' };
const zh = lang === 'zh-TW';
const panels: { title: string; max: number; unit: string; bands: Band[] }[] = [
  {
    title: zh ? '前 50 毫秒' : 'First 50 ms',
    max: 50,
    unit: 'ms',
    bands: [
      { from: 0, to: 8, label: zh ? '8 台和資料庫斷線' : 'All 8 lose the database', time: '.462–.470', kind: 'bad' },
      { from: 23, to: 43, label: zh ? '8 個行程結束（exit 7）' : 'All 8 processes exit (code 7)', time: '.485–.505', kind: 'bad' },
    ],
  },
  {
    title: zh ? '接下來 12 秒' : 'Next 12 s',
    max: 12,
    unit: 's',
    bands: [
      { from: 0.04, to: 11, label: zh ? '約 11 秒沒有服務' : 'About 11 s with no service', time: '', kind: 'span' },
      { from: 0.05, to: 3.1, label: zh ? 'Docker 拆掉網路' : 'Docker tears down networking', time: zh ? '結束後、重啟前' : 'after the exit, before the restart', kind: 'gap' },
      { from: 3.1, to: 3.9, label: zh ? '容器重啟' : 'Containers restart', time: '43.6–44.4' },
      { from: 10.5, to: 11.5, label: zh ? '恢復服務' : 'Serving again', time: '51–52', kind: 'ok' },
    ],
  },
];
const caption = zh
  ? '2026-10-30 02:44:40 起的系統日誌，依毫秒排序。網路的變化在行程結束之後，所以是結果，不是原因。'
  : 'System journal from 02:44:40 on October 30, 2026, in millisecond order. The network change comes after the exit, so it is an effect, not the cause.';
const replay = zh ? '重播' : 'Replay';
---

<figure class="tl" data-tl>
  <div class="panels">
    {panels.map((p, pi) => (
      <div class="panel" style={`--start:${pi === 0 ? 0 : 1}`}>
        <p class="ptitle">{p.title}</p>
        <div class="track" style={`--rows:${p.bands.length}`}>
          <span class="head" aria-hidden="true"></span>
          {p.bands.map((b, bi) => (
            <div
              class={`band ${b.kind ?? ''} ${b.from / p.max > 0.4 ? 'right' : ''}`}
              style={`--l:${(b.from / p.max) * 100}%;--w:${Math.max(((b.to - b.from) / p.max) * 100, 1.2)}%;--at:${b.from / p.max};--row:${bi}`}
            >
              <span class="bar"></span>
              <span class="lbl"><b>{b.label}</b>{b.time && <small>{b.time}</small>}</span>
            </div>
          ))}
        </div>
        <p class="axis"><span>0</span><span>{p.max} {p.unit}</span></p>
      </div>
    ))}
  </div>
  <button type="button" data-replay>{replay}</button>
  <figcaption>{caption}</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-tl]').forEach((root) => {
    const play = () => {
      root.classList.remove('play');
      void root.offsetWidth; // 重設 transition，才能重播
      root.classList.add('play');
    };
    root.querySelector('[data-replay]')!.addEventListener('click', play);
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { play(); io.disconnect(); }
    }, { threshold: 0.5 });
    io.observe(root);
  });
</script>

<style>
  .tl {
    --dur: 2.2s;
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--paper-tint);
  }
  .panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  @media (max-width: 640px) {
    .panels { grid-template-columns: 1fr; }
  }
  .ptitle {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
    margin-bottom: 0.5rem;
  }
  .track {
    position: relative;
    height: calc(var(--rows) * 3.2rem + 1rem);
    border-left: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .head {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    background: var(--accent);
    opacity: 0;
  }
  .band {
    position: absolute;
    left: var(--l);
    width: var(--w);
    top: calc(var(--row) * 3.2rem + 0.5rem);
    opacity: 0.12;
  }
  .bar {
    display: block;
    width: 0;
    min-width: 4px;
    height: 0.6rem;
    border-radius: 2px;
    background: var(--ink-soft);
  }
  .band.right .bar { margin-left: auto; }
  .band.bad .bar { background: var(--accent); }
  .band.ok .bar { background: var(--ink); }
  .band.span .bar,
  .band.gap .bar {
    height: 0.25rem;
    margin-top: 0.175rem;
    background: repeating-linear-gradient(90deg, var(--accent) 0 6px, transparent 6px 10px);
  }
  .band.gap .bar {
    background: repeating-linear-gradient(90deg, var(--ink-faint) 0 3px, transparent 3px 7px);
  }
  .lbl {
    position: absolute;
    left: 0;
    top: 0.9rem;
    white-space: nowrap;
    font-size: var(--step--2);
    line-height: 1.35;
    color: var(--ink-soft);
  }
  .band.right .lbl { left: auto; right: 0; text-align: right; }
  .lbl b { display: block; font-weight: 500; color: var(--ink); }
  .lbl small { font-family: var(--font-mono); color: var(--ink-faint); }
  .axis {
    display: flex;
    justify-content: space-between;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-faint);
  }

  /* 播放：游標掃過，每條色帶在游標經過時長出來 */
  .play .head {
    animation: sweep var(--dur) linear forwards;
    animation-delay: calc(var(--start) * var(--dur));
  }
  @keyframes sweep {
    0% { left: 0; opacity: 1; }
    99% { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }
  .play .band {
    opacity: 1;
    transition: opacity 300ms ease-out;
    transition-delay: calc((var(--start) + var(--at)) * var(--dur));
  }
  .play .bar {
    width: 100%;
    transition: width 400ms var(--ease-out);
    transition-delay: calc((var(--start) + var(--at)) * var(--dur));
  }

  button {
    margin-top: 1rem;
    padding: 0.4em 0.9em;
    border: 1px solid var(--ink-soft);
    border-radius: 3px;
    background: transparent;
    color: var(--ink);
    font-size: var(--step--1);
    cursor: pointer;
  }
  button:hover { border-color: var(--accent); color: var(--accent); }
  figcaption {
    margin-top: 0.75rem;
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
  @media (prefers-reduced-motion: reduce) {
    .band { opacity: 1; }
    .bar { width: 100%; }
    .play .head { animation: none; }
  }
</style>
