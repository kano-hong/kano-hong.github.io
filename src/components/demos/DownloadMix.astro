---
// 首訪下載量的組成：Service Worker 預快取＋頁面本身。數字是 2026-11-11 在 staging 用真的 Chrome、
// 全新設定檔量的 iframe 首訪傳輸量（CDP 分開加總頁面與 SW）。
interface Props { lang?: 'zh-TW' | 'en' }
const { lang = 'zh-TW' } = Astro.props;
const zh = lang === 'zh-TW';
const TOTAL = 65.25;
const segs = [
  {
    key: 'sw', before: 49.46, after: 1.72,
    name: zh ? 'Service Worker 預快取' : 'Service worker precache',
    why: zh
      ? '原本 3,664 個檔案全部預快取，每張圖的 .basis 和 .webp 都抓；改成只留引擎與入口，遊戲包用到才下載、只抓裝置用的格式。'
      : 'It used to precache all 3,664 files, both the .basis and .webp copy of every image. Now only the engine and entry point; the game bundle downloads when needed, in the one format the device uses.',
  },
  {
    key: 'page', before: 15.78, after: 12.24,
    name: zh ? '頁面本身' : 'The page itself',
    why: zh
      ? '背景預載原本一次載入 8 套牌桌主題；改成登入後只載玩家選的那一套。'
      : 'The background preload used to load all 8 table themes; now it loads only the player’s choice, after login.',
  },
];
const pct = (v: number) => `${((v / TOTAL) * 100).toFixed(2)}%`;
const T = zh
  ? { label: '首次造訪下載量', replay: '重播', caption: 'staging 環境，真的 Chrome、全新設定檔，量背景 iframe 的首次造訪，頁面與 Service Worker 分開加總（傳輸量，2026-11-11）。' }
  : { label: 'First-visit download', replay: 'Replay', caption: 'Staging, real Chrome with a fresh profile, measuring the background iframe’s first visit, with page and service worker counted separately (bytes transferred, 2026-11-11).' };
---

<figure class="mix" data-mix data-from={TOTAL} data-to={segs.reduce((s, x) => s + x.after, 0).toFixed(2)}>
  <p class="total"><span data-num>{TOTAL.toFixed(2)}</span> MB <small>{T.label}</small></p>
  <div class="track" aria-hidden="true">
    {segs.map((s) => (
      <span class={`seg ${s.key}`} style={`--b:${pct(s.before)};--a:${pct(s.after)}`}></span>
    ))}
  </div>
  <p class="axis"><span>0</span><span>65 MB</span></p>
  <ul class="legend">
    {segs.map((s) => (
      <li class={s.key}>
        <p class="lname"><i></i>{s.name}<span>{s.before} → {s.after} MB</span></p>
        <p class="lwhy">{s.why}</p>
      </li>
    ))}
  </ul>
  <button type="button" data-replay>{T.replay}</button>
  <figcaption>{T.caption}</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-mix]').forEach((root) => {
    const num = root.querySelector<HTMLElement>('[data-num]')!;
    const from = Number(root.dataset.from);
    const to = Number(root.dataset.to);
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DELAY = 600;
    const DUR = 1600;
    let raf = 0;
    const play = () => {
      cancelAnimationFrame(raf);
      root.classList.add('reset'); // 先關掉 transition 讓色條瞬間回到改前，才能重播
      root.classList.remove('play');
      num.textContent = from.toFixed(2);
      void root.offsetWidth;
      root.classList.remove('reset');
      root.classList.add('play');
      if (still) { num.textContent = to.toFixed(2); return; }
      const t0 = performance.now() + DELAY;
      const tick = (now: number) => {
        const k = Math.min(Math.max((now - t0) / DUR, 0), 1);
        const e = 1 - Math.pow(1 - k, 3);
        num.textContent = (from + (to - from) * e).toFixed(2);
        if (k < 1) raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
    };
    root.querySelector('[data-replay]')!.addEventListener('click', play);
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { play(); io.disconnect(); }
    }, { threshold: 0.6 });
    io.observe(root);
  });
</script>

<style>
  .mix {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--paper-tint);
  }
  .mix .total {
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1.1;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }
  .mix .total span { font-variant-numeric: tabular-nums; color: var(--accent); }
  .mix .total small {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
  .track {
    display: flex;
    height: 1.5rem;
    border-radius: 3px;
    background: var(--rule-soft);
    overflow: hidden;
  }
  .seg {
    width: var(--b);
    height: 100%;
    transition: width 1600ms cubic-bezier(0.33, 1, 0.68, 1) 600ms;
  }
  .play .seg { width: var(--a); }
  .reset .seg { transition: none; }
  .seg.sw { background: var(--accent); }
  .seg.page { background: var(--ink-soft); }
  .mix .axis {
    display: flex;
    justify-content: space-between;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-faint);
  }
  .mix .legend {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .mix .legend li { margin: 0; }
  .mix .lname {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    font-size: var(--step--1);
    color: var(--ink);
    font-weight: 500;
  }
  .mix .lname i {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 2px;
  }
  .mix .sw .lname i { background: var(--accent); }
  .mix .page .lname i { background: var(--ink-soft); }
  .mix .lname span {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 400;
    color: var(--ink-faint);
  }
  .mix .lwhy {
    margin-top: 0.2rem;
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--ink-soft);
  }
  button {
    margin-top: 1rem;
    padding: 0.4em 0.9em;
    border: 1px solid var(--ink-soft);
    border-radius: 3px;
    background: transparent;
    color: var(--ink);
    font-size: var(--step--1);
    cursor: pointer;
  }
  button:hover { border-color: var(--accent); color: var(--accent); }
  figcaption {
    margin-top: 0.75rem;
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
  @media (prefers-reduced-motion: reduce) {
    .seg { transition: none; }
  }
</style>
