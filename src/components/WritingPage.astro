---
import { getCollection } from 'astro:content';
import PostCard from '~/components/PostCard.astro';
import { type Lang } from '~/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = lang === 'zh-TW' ? '' : '/en';

const posts = (
  await getCollection('blog', (e) => !e.data.draft && e.data.lang === lang)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// 依照 series 分群
const grouped = posts.reduce(
  (acc, p) => {
    const key = p.data.series ?? '__solo__';
    if (!acc[key]) acc[key] = [];
    acc[key].push(p);
    return acc;
  },
  {} as Record<string, typeof posts>
);

const seriesOrder = Object.keys(grouped).filter((k) => k !== '__solo__');
const soloPosts = grouped['__solo__'] || [];

const title = lang === 'zh-TW' ? '寫作' : 'Writing';
const eyebrow = lang === 'zh-TW' ? '技術筆記' : 'Technical notes';
const intro =
  lang === 'zh-TW'
    ? '從兩年的日報中長出來的技術筆記。著重在架構決策、技術選型背後的理由，以及試過之後不會再做的事。'
    : 'Notes that grew out of two years of daily logs. Focused on architectural decisions, why we picked what we picked, and what we’d never do again.';
---

<section class="page-head">
  <div class="wrap">
    <p class="eyebrow rise">{eyebrow}</p>
    <h1 class="page-title rise delay-1">{title}</h1>
    <p class="page-intro rise delay-2">{intro}</p>
  </div>
</section>

<section class="page-body">
  <div class="wrap">
    {
      seriesOrder.map((series) => (
        <div class="series-block">
          <h2 class="series-label">
            <span class="series-icon" aria-hidden="true">⌗</span> {series}
          </h2>
          <div class="card-list">
            {grouped[series].map((post) => (
              <PostCard
                href={`${base}${prefix}/writing/${post.data.slug}/`}
                title={post.data.title}
                summary={post.data.summary}
                date={post.data.date}
                readTime={post.data.readTime}
                tags={post.data.tags}
                lang={lang}
              />
            ))}
          </div>
        </div>
      ))
    }

    {
      soloPosts.length > 0 && (
        <div class="series-block">
          {seriesOrder.length > 0 && (
            <h2 class="series-label">
              <span class="series-icon" aria-hidden="true">⌗</span>{' '}
              {lang === 'zh-TW' ? '其他' : 'Other'}
            </h2>
          )}
          <div class="card-list">
            {soloPosts.map((post) => (
              <PostCard
                href={`${base}${prefix}/writing/${post.data.slug}/`}
                title={post.data.title}
                summary={post.data.summary}
                date={post.data.date}
                readTime={post.data.readTime}
                tags={post.data.tags}
                lang={lang}
              />
            ))}
          </div>
        </div>
      )
    }

    {
      posts.length === 0 && (
        <p class="empty">
          {lang === 'zh-TW' ? '正在寫了。' : 'Writing in progress.'}
        </p>
      )
    }
  </div>
</section>

<style>
  .page-head {
    padding-top: clamp(3rem, 8vh, 5rem);
    padding-bottom: clamp(2rem, 5vh, 4rem);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--step-5);
    font-weight: 400;
    letter-spacing: -0.035em;
    margin-block: 0.75rem 1.5rem;
  }

  .page-intro {
    font-size: var(--step-1);
    color: var(--ink-soft);
    max-width: 52ch;
    line-height: 1.55;
  }

  .page-body {
    padding-bottom: var(--section-y);
  }

  .series-block + .series-block {
    margin-top: 4rem;
  }

  .series-label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .series-icon {
    color: var(--accent);
  }

  .empty {
    padding: 4rem 0;
    color: var(--ink-faint);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    text-align: center;
  }
</style>
