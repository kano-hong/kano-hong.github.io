---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { getLangFromUrl, switchLangPath, useTranslations, type Lang } from '~/i18n';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang?: Lang;
}

const { title, description, ogImage } = Astro.props;
const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const desc =
  description ??
  (lang === 'zh-TW'
    ? 'Kano Hong — Game Client Tech Lead／遊戲客戶端技術主管。Cocos Creator、TypeScript、狀態機架構，把混亂的開發流程改造成可重複的系統。'
    : 'Kano Hong — Game Client Tech Lead. Cocos Creator, TypeScript, state-machine architecture, and turning messy pipelines into repeatable systems.');

const fullTitle = title.includes('Kano') ? title : `${title} — Kano Hong`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const zhURL = new URL(withSlash(switchLangPath(Astro.url.pathname, 'zh-TW')), Astro.site);
const enURL = new URL(withSlash(switchLangPath(Astro.url.pathname, 'en')), Astro.site);
const ogImageURL = ogImage
  ? new URL(ogImage, Astro.site).toString()
  : new URL(lang === 'en' ? '/og-default-en.png' : '/og-default.png', Astro.site).toString();
---

<!doctype html>
<html lang={lang === 'zh-TW' ? 'zh-Hant-TW' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="zh-Hant-TW" href={zhURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="x-default" href={zhURL} />
    {lang === 'zh-TW' && (
      <script is:inline>
        // 瀏覽器語言沒有中文、也沒手動選過語言時，第一次就帶到英文版同一頁。爬蟲不轉。
        (function () {
          try { if (localStorage.getItem('lang')) return; } catch (e) {}
          if (/bot|crawl|spider|slurp|preview|facebookexternalhit/i.test(navigator.userAgent)) return;
          var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
          for (var i = 0; i < langs.length; i++) if (/^zh/i.test(langs[i])) return;
          location.replace('/en' + location.pathname + location.search + location.hash);
        })();
      </script>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={lang === 'zh-TW' ? 'zh_TW' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Preconnect (none needed - all fonts are self-hosted via fontsource) -->
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <style>
      .skip-link {
        position: absolute;
        top: -100px;
        left: var(--gutter);
        background: var(--ink);
        color: var(--paper);
        padding: 0.5rem 1rem;
        z-index: 100;
        border-radius: 2px;
        font-family: var(--font-mono);
        font-size: var(--step--1);
        transition: top var(--duration-fast) var(--ease-out);
      }
      .skip-link:focus {
        top: 0.5rem;
      }
    </style>
    <!-- Cloudflare Web Analytics：不用 cookie，後台在 Cloudflare 帳號的 Web analytics -->
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "dea6e15834364ba7aa3178acab0a8c8f"}'></script>
  </body>
</html>
