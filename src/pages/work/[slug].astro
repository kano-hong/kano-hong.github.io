---
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ImpactBox from '~/components/ImpactBox.astro';
import { useTranslations } from '~/i18n';

export async function getStaticPaths() {
  const projects = await getCollection(
    'projects',
    (e) => e.data.lang === 'zh-TW'
  );
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const t = useTranslations('zh-TW');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title={`${project.data.title} — Kano Hong`}
  description={project.data.summary}
  lang="zh-TW"
>
  <article class="project" style={project.data.accent ? `--accent: ${project.data.accent}` : undefined}>
    <header class="project-header">
      <div class="wrap-narrow">
        <a class="back" href={`${base}/work/`}>{t('project.back')}</a>

        <p class="eyebrow">{project.data.year} · {project.data.role}{project.data.company ? ` · ${project.data.company}` : ''}</p>

        <h1 class="project-title">{project.data.title}</h1>

        <p class="project-summary serif-italic">{project.data.summary}</p>
      </div>

      {project.data.impact && (
        <div class="wrap-narrow">
          <ImpactBox lang="zh-TW" impact={project.data.impact} />
        </div>
      )}

      <div class="wrap-narrow">
        <dl class="meta-grid">
          <div>
            <dt>{t('project.year')}</dt>
            <dd>{project.data.year}</dd>
          </div>
          <div>
            <dt>{t('project.role')}</dt>
            <dd>{project.data.role}</dd>
          </div>
          <div class="stack-cell">
            <dt>{t('project.stack')}</dt>
            <dd>
              <ul>
                {project.data.stack.map((s) => <li>{s}</li>)}
              </ul>
            </dd>
          </div>
        </dl>
      </div>
    </header>

    <div class="wrap-narrow project-body">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .project {
    padding-top: clamp(2rem, 6vh, 4rem);
    padding-bottom: var(--section-y);
  }

  .project-header {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2.5rem;
    margin-bottom: 3rem;
  }

  .back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-faint);
    text-decoration: none;
    margin-bottom: 2rem;
    transition: color var(--duration-base) var(--ease-out);
  }

  .back:hover {
    color: var(--accent);
  }

  .eyebrow {
    margin-bottom: 1rem;
  }

  .project-title {
    font-family: var(--font-display);
    font-size: var(--step-5);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin-bottom: 1.5rem;
  }

  .project-summary {
    font-size: var(--step-2);
    color: var(--ink-soft);
    line-height: 1.4;
    max-width: 50ch;
    margin-bottom: 2.5rem;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 720px) {
    .meta-grid {
      grid-template-columns: auto auto 1fr;
      gap: 2.5rem;
      align-items: start;
    }
  }

  .meta-grid > div {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .meta-grid dt {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-faint);
    font-weight: 500;
  }

  .meta-grid dd {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--step-0);
  }

  .stack-cell ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .stack-cell li {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    padding: 0.2em 0.6em;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--paper-tint);
    color: var(--ink-soft);
  }

  .project-body {
    padding-top: 1rem;
  }

  /* Prose typography matches blog */
  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-top: 3rem;
    margin-bottom: 0.75rem;
    line-height: 1.2;
    position: relative;
    padding-left: 1.5rem;
  }

  .prose :global(h2)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.75rem;
    height: 2px;
    background: var(--accent);
  }

  .prose :global(h3) {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    margin-top: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .prose :global(p) {
    font-size: var(--step-0);
    line-height: 1.75;
    color: var(--ink-soft);
    margin-bottom: 1.25rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .prose :global(li) {
    line-height: 1.7;
    color: var(--ink-soft);
    margin-bottom: 0.4rem;
  }

  .prose :global(blockquote) {
    margin: 2rem 0;
    padding: 0.5rem 0 0.5rem 1.5rem;
    border-left: 2px solid var(--accent);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--ink-soft);
  }

  .prose :global(pre) {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border-radius: 4px;
    border: 1px solid var(--rule);
    overflow-x: auto;
    font-size: var(--step--1);
    line-height: 1.7;
  }
</style>
